{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "noImplicitReturns": true,
    "types": [
      "node",
      "vscode"
    ],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "dist"
  ]
}
